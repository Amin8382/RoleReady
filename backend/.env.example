# RoleReady Backend Environment Configuration

# Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Backend: 'sqlite' or 'supabase'
DATABASE_BACKEND=sqlite
SQLITE_DB_PATH=backend/data/roleready_local.db

# Supabase (Required if DATABASE_BACKEND=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-local-verification
SUPABASE_STORAGE_BUCKET=cv-uploads

# Authentication: in 'development' mode without secrets, dev tokens are accepted
AUTH_ENFORCE_JWT=false

# Scoring Backend: 'mock', 'ollama', 'vllm', or 'hf_api'
SCORER_BACKEND=mock
PROMETHEUS_ENDPOINT=http://localhost:11434/api/generate
PROMETHEUS_MODEL_NAME=prometheus-eval:7b-v2
PROMETHEUS_TIMEOUT_SECONDS=45
PROMETHEUS_API_KEY=

# Audio Adapters (Whisper & Kokoro stubs / external endpoints)
WHISPER_ENDPOINT=http://localhost:8001/transcribe
KOKORO_ENDPOINT=http://localhost:8002/speak

